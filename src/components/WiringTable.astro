---
// Wiring table for one device in one mode, from the planner's data. The Raspberry Pi
// columns follow the viewer's setup (<Pin>, src/data/setup/pins.js).
//   <WiringTable device="esp32-c5-devkitc-1" mode="spi" />
import { DEVICES } from '../data/setup/devices.js';
import { signalsOf } from '../data/setup/allocate.js';
import Pin from './Pin.astro';

interface Props {
  device: string;
  mode?: string;
}

const { device, mode } = Astro.props;
const dev = DEVICES.find((d) => d.id === device);
if (!dev) throw new Error(`WiringTable: unknown device "${device}"`);
const signals = signalsOf(dev, mode);
if (!signals) throw new Error(`WiringTable: ${device} has no mode "${mode}"`);
const wired = signals.filter((s) => s.type === 'gpio' || s.type === 'power' || s.type === 'ground');
const revisions = Object.entries(dev.pinouts ?? {}).reverse(); // newest board revision first
// Where a device pin sits on the device's own headers, e.g. "J1-11"; any GND for ground
const where = (pinout, name) =>
  name === 'GND' ? 'any GND' : pinout.filter((p) => p.name === name).map((p) => `${p.header}-${p.no}`).join(', ') || '—';
---

<table>
  <thead>
    <tr>
      <th>Function</th>
      <th>{dev.name.replace(/-DevKit.*$/, '')} pin</th>
      {revisions.map(([rev]) => <th>DevKit header ({rev})</th>)}
      <th>Pi physical pin</th>
      <th>Pi GPIO</th>
    </tr>
  </thead>
  <tbody>
    {wired.map((s) => (
      <tr>
        <td>{s.label}</td>
        <td>{s.devicePin}</td>
        {revisions.map(([, pinout]) => <td>{where(pinout, s.devicePin)}</td>)}
        <td><Pin signal={`${dev.id}.${s.id}`} show="pin" /></td>
        <td>{s.type === 'gpio' ? <>GPIO<Pin signal={`${dev.id}.${s.id}`} show="gpio" /></> : '—'}</td>
      </tr>
    ))}
  </tbody>
</table>

---
// The setup pages' app (src/components/setup/setup-app.js): page 1 "start" (Raspberry Pi
// and track), page 2 "peripherals", page 3 "pins"; and "wiring", the wiring steps in
// chapter 0. The wiring steps show chapter 0's own content, so they keep the page's
// content styles; their controls are marked not-content instead.
interface Props {
  page: 'start' | 'peripherals' | 'pins' | 'wiring';
}
const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div
  id="pst-setup-app"
  class:list={['pst-setup', page !== 'wiring' && 'not-content', `pst-page-${page}`]}
  data-page={page}
  data-home={`${base}/`}
  data-start={`${base}/setup/`}
  data-peripherals={`${base}/setup/peripherals/`}
  data-pins={`${base}/setup/pins/`}
>
  <noscript>This page needs JavaScript. Without it, the tutorial shows everything.</noscript>
</div>

<script>
  import { mount } from './setup-app.js';

  const root = document.getElementById('pst-setup-app');
  if (root) mount(root);
</script>

<style is:global>
  /* The pins page needs room for the map and the components side by side */
  html:has(.pst-page-pins) {
    --sl-content-width: 67.5rem;
  }

  .pst-setup {
    --pst-radius: 0.75rem;
    margin-top: 1.5rem;
  }
  .pst-setup .pst-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .pst-setup h2 {
    font-size: var(--sl-text-h4);
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0 0 0.75rem;
  }
  .pst-setup .pst-muted {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    margin: 0.25rem 0 0;
  }

  /* Steps */
  .pst-setup .pst-steps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    padding: 0 0 1rem;
    margin: 0 0 1.5rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-sm);
  }
  .pst-setup .pst-step {
    display: flex;
    align-items: center;
    color: var(--sl-color-gray-3);
  }
  .pst-setup .pst-step a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .pst-setup .pst-step a:hover {
    color: var(--sl-color-white);
  }
  .pst-setup .pst-step-current {
    color: var(--sl-color-white);
    font-weight: 600;
  }
  .pst-setup .pst-step-no {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    border: 1px solid currentColor;
    font-size: var(--sl-text-xs);
  }
  .pst-setup .pst-step-current .pst-step-no {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-black);
  }

  .pst-setup .pst-section {
    margin: 0 0 2rem;
  }

  /* Page 1: two boxes side by side */
  .pst-setup .pst-boxes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .pst-setup .pst-box {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 5.5rem;
    padding: 1rem;
    border: 2px solid var(--sl-color-gray-5);
    border-radius: var(--pst-radius);
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
    text-align: center;
    cursor: pointer;
    transition: border-color 0.15s, background-color 0.15s;
  }
  .pst-setup .pst-box:hover {
    border-color: var(--sl-color-gray-3);
  }
  /* The name stays in the middle of the box, with or without a reason under it, so the
     names of two boxes side by side line up */
  .pst-setup .pst-box {
    display: grid;
    grid-template-rows: 1fr auto 1fr;
    justify-items: center;
  }
  .pst-setup .pst-box-title {
    grid-row: 2;
  }
  .pst-setup .pst-box-reason {
    grid-row: 3;
    align-self: start;
    margin-top: 0.25rem;
  }
  .pst-setup .pst-box-title {
    font-size: var(--sl-text-lg);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .pst-setup .pst-box-reason {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .pst-setup .pst-box.pst-off {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .pst-setup .pst-box.pst-off:hover {
    border-color: var(--sl-color-gray-5);
  }

  /* Page 2: one box per hardware item */
  /* Each box takes three rows of the section's grid (name, SPI/SDIO, reason), shared with
     the boxes beside it, so their names, buttons and reasons line up */
  .pst-setup .pst-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    column-gap: 0.75rem;
    row-gap: 0;
  }
  .pst-setup .pst-card {
    position: relative;
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: 0;
    align-content: start;
    margin-bottom: 0.75rem;
    cursor: pointer;
    padding: 0.85rem 1rem;
    border: 2px solid var(--sl-color-gray-5);
    border-radius: var(--pst-radius);
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
    transition: border-color 0.15s, background-color 0.15s;
  }
  .pst-setup .pst-card:not(.pst-off):hover {
    border-color: var(--sl-color-gray-3);
  }
  .pst-setup .pst-card-main {
    grid-row: 1;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .pst-setup .pst-card-extra {
    grid-row: 2;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 0.5rem;
  }
  .pst-setup .pst-card-reason.pst-card-why {
    grid-row: 3;
    margin-top: 0.5rem;
  }
  /* The whole box toggles the hardware, not only its name */
  .pst-setup .pst-card-main::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .pst-setup .pst-card-title {
    font-weight: 600;
    color: var(--sl-color-white);
    line-height: 1.35;
  }
  .pst-setup .pst-card-sub {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .pst-setup .pst-card-reason {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .pst-setup .pst-card.pst-off {
    opacity: 0.55;
  }
  .pst-setup .pst-card.pst-off {
    cursor: not-allowed;
  }
  .pst-setup .pst-card.pst-bad {
    border-color: var(--sl-color-red);
  }
  .pst-setup .pst-card.pst-bad .pst-card-reason {
    color: var(--sl-color-red-high);
  }

  /* Selected boxes and cards */
  .pst-setup .pst-box.pst-on,
  .pst-setup .pst-card.pst-on {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }
  /* Keyboard focus only: a ring around the whole box */
  .pst-setup .pst-box:has(input:focus-visible),
  .pst-setup .pst-card:has(.pst-card-main input:focus-visible) {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  /* SPI | SDIO inside the ESP32 box */
  .pst-setup .pst-segments {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-self: flex-start;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.5rem;
    overflow: hidden;
    font-size: var(--sl-text-sm);
  }
  .pst-setup .pst-segment {
    padding: 0.2rem 0.9rem;
    cursor: pointer;
    color: var(--sl-color-gray-2);
  }
  .pst-setup .pst-segment + .pst-segment {
    border-left: 1px solid var(--sl-color-gray-4);
  }
  .pst-setup .pst-segment.pst-on {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    font-weight: 600;
  }
  .pst-setup .pst-segment.pst-off {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .pst-setup .pst-segment:has(input:focus-visible) {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -2px;
  }

  /* Back / Next / Save */
  .pst-setup .pst-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: 1.5rem;
  }
  .pst-setup .pst-btn {
    font: inherit;
    padding: 0.45rem 1.1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-gray-4);
    background: transparent;
    color: var(--sl-color-white);
    text-decoration: none;
    cursor: pointer;
  }
  .pst-setup .pst-btn:hover:not(:disabled) {
    border-color: var(--sl-color-gray-2);
  }
  .pst-setup .pst-btn.pst-primary:not(:disabled) {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-black);
    font-weight: 600;
  }
  .pst-setup .pst-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .pst-setup .pst-status {
    flex-basis: 100%;
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  /* Page 3: map on the left, components on the right */
  .pst-setup .pst-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  .pst-setup .pst-layout-single {
    grid-template-columns: minmax(0, 1fr);
  }
  .pst-setup .pst-map {
    position: sticky;
    top: calc(var(--sl-nav-height, 4rem) + 1rem);
  }
  @media (max-width: 50rem) {
    .pst-setup .pst-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .pst-setup .pst-map {
      position: static;
    }
  }
  /* Assigned pins: Starlight's Next link before the setup is saved (page-pins.js) */
  .pagination-links a.pst-next-off,
  .pagination-links a.pst-next-off:hover {
    opacity: 0.55;
    cursor: not-allowed;
    border-color: var(--sl-color-gray-5);
  }
  .pst-setup .pst-map-title {
    font-size: var(--sl-text-base);
    margin-bottom: 0.5rem;
  }
  .pst-setup .pst-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto minmax(0, 1fr);
    align-items: center;
    gap: 0.3rem 0.6rem;
    margin-top: 0.5rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--pst-radius);
    background: var(--sl-color-gray-6);
    font-size: var(--sl-text-sm);
  }
  /* A pin's name sits right beside it and never shrinks or wraps; all names are as wide
     as the longest (set by page-pins.js), so the badges line up. The badges take what is
     left of the row (cut with … when long, the whole text is in the tooltip). */
  .pst-setup .pst-label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    transition: opacity 0.15s;
  }
  .pst-setup .pst-label.pst-used {
    cursor: pointer;
  }
  .pst-setup .pst-left {
    flex-direction: row-reverse;
  }
  /* The name stays right beside its pin */
  .pst-setup .pst-left .pst-pin-name {
    text-align: right;
  }
  .pst-setup .pst-pin-name {
    flex-shrink: 0;
    width: var(--pst-name-w, auto);
    white-space: nowrap;
    color: var(--sl-color-gray-2);
    font-variant-numeric: tabular-nums;
  }
  .pst-setup .pst-badge {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    padding: 0.05rem 0.55rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--m) 70%, transparent);
    background: color-mix(in srgb, var(--m) 18%, transparent);
    color: var(--sl-color-white);
    font-size: var(--sl-text-xs);
    line-height: 1.5;
  }
  .pst-setup .pst-label.pst-lit .pst-badge {
    border-color: var(--m);
    background: color-mix(in srgb, var(--m) 38%, transparent);
    font-weight: 600;
  }
  /* Module colours (dataviz reference palette: blue, magenta, yellow, green); grey after
     four modules and for breadboard rails. Dark is Starlight's default theme. */
  .pst-setup {
    --pst-m1: #3987e5;
    --pst-m2: #d55181;
    --pst-m3: #c98500;
    --pst-m4: #008300;
  }
  :root[data-theme='light'] .pst-setup {
    --pst-m1: #2a78d6;
    --pst-m2: #e87ba4;
    --pst-m3: #eda100;
    --pst-m4: #008300;
  }
  .pst-setup .pst-m0,
  .pst-setup .pst-badge-rail,
  .pst-setup .pst-dot-rail {
    --m: var(--sl-color-gray-3);
  }
  .pst-setup .pst-m1 { --m: var(--pst-m1); }
  .pst-setup .pst-m2 { --m: var(--pst-m2); }
  .pst-setup .pst-m3 { --m: var(--pst-m3); }
  .pst-setup .pst-m4 { --m: var(--pst-m4); }
  .pst-setup .pst-dot {
    display: inline-block;
    width: 0.65rem;
    height: 0.65rem;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--m);
    vertical-align: 0.05em;
  }
  /* Phones: a long badge goes under its pin name instead of being cut */
  @media (max-width: 30rem) {
    .pst-setup .pst-header {
      gap: 0.35rem 0.4rem;
      padding: 0.6rem 0.4rem;
    }
    .pst-setup .pst-label {
      flex-wrap: wrap;
      row-gap: 0.15rem;
    }
  }
  .pst-setup .pst-hpin,
  .pst-setup .pst-swatch {
    --pst-hpin: var(--sl-color-green);
    --pst-pin-low: var(--sl-color-green-low);
    --pst-pin-high: var(--sl-color-green-high);
    --pst-pin-fill: var(--sl-color-green);
    border: 2px solid var(--pst-hpin);
    border-radius: 50%;
    background: var(--pst-pin-low);
    color: var(--pst-pin-high);
  }
  .pst-setup span.pst-hpin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    cursor: default;
  }
  .pst-setup .pst-hpin {
    width: 1.9rem;
    height: 1.9rem;
    padding: 0;
    font: inherit;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .pst-setup .pst-k-3v3 {
    --pst-hpin: var(--sl-color-orange);
    --pst-pin-low: var(--sl-color-orange-low);
    --pst-pin-high: var(--sl-color-orange-high);
    --pst-pin-fill: var(--sl-color-orange);
  }
  .pst-setup .pst-k-5v {
    --pst-hpin: var(--sl-color-red);
    --pst-pin-low: var(--sl-color-red-low);
    --pst-pin-high: var(--sl-color-red-high);
    --pst-pin-fill: var(--sl-color-red);
  }
  .pst-setup .pst-k-gnd {
    --pst-hpin: var(--sl-color-gray-3);
    --pst-pin-low: var(--sl-color-gray-5);
    --pst-pin-high: var(--sl-color-white);
    --pst-pin-fill: hsl(224, 6%, 62%);
  }
  .pst-setup .pst-hpin.pst-reserved,
  .pst-setup .pst-swatch.pst-reserved {
    --pst-hpin: var(--sl-color-gray-4);
    --pst-pin-low: transparent;
    --pst-pin-high: var(--sl-color-gray-3);
    border-style: dashed;
  }
  .pst-setup .pst-hpin.pst-used {
    background: var(--pst-pin-fill);
    color: hsl(224, 10%, 10%);
  }
  .pst-setup .pst-covered {
    opacity: 0.35;
  }
  .pst-setup .pst-hpin.pst-target {
    border-style: dashed;
    border-color: var(--sl-color-text-accent);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-text-accent);
  }
  .pst-setup .pst-label.pst-target .pst-pin-name {
    color: var(--sl-color-text-accent);
  }
  .pst-setup .pst-hpin.pst-lit {
    box-shadow: 0 0 0 3px var(--sl-color-text-accent);
  }
  .pst-setup .pst-hpin.pst-selected {
    outline: 3px solid var(--sl-color-white);
    outline-offset: 2px;
  }
  .pst-setup .pst-dim {
    opacity: 0.25;
  }
  .pst-setup .pst-keys {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.6rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
  }
  .pst-setup .pst-key {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .pst-setup .pst-swatch {
    display: inline-block;
    width: 0.85rem;
    height: 0.85rem;
  }

  /* Components */
  .pst-setup .pst-parts {
    display: grid;
    gap: 0.75rem;
  }
  .pst-setup .pst-part {
    padding: 0.75rem 1rem;
    border: 2px solid var(--sl-color-gray-5);
    border-radius: var(--pst-radius);
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
    transition: border-color 0.15s, opacity 0.15s;
  }
  .pst-setup .pst-part.pst-part-on {
    border-color: var(--sl-color-accent);
  }
  .pst-setup .pst-part.pst-part-dim {
    opacity: 0.5;
  }
  .pst-setup .pst-part.pst-bad {
    border-color: var(--sl-color-red);
  }
  .pst-setup .pst-part h3 {
    margin: 0 0 0.4rem;
    font-size: var(--sl-text-base);
  }
  .pst-setup .pst-part-name {
    font: inherit;
    font-weight: 600;
    padding: 0.1rem 0.6rem;
    margin-left: -0.6rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--sl-color-white);
    cursor: pointer;
  }
  .pst-setup .pst-part-name:hover,
  .pst-setup .pst-part-name[aria-pressed='true'] {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-text-accent);
  }
  .pst-setup .pst-part table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
  }
  .pst-setup .pst-part th,
  .pst-setup .pst-part td {
    text-align: left;
    padding: 0.3rem 0.4rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .pst-setup .pst-part th {
    color: var(--sl-color-gray-3);
    font-weight: 500;
  }
  .pst-setup .pst-part tr:last-child td {
    border-bottom: 0;
  }
  .pst-setup .pst-part tr.pst-row-on td {
    background: var(--sl-color-accent-low);
  }
  .pst-setup .pst-part .pst-row-note td {
    color: var(--sl-color-gray-3);
  }
  .pst-setup .pst-part select {
    font: inherit;
    padding: 0.1rem 0.25rem;
    border-radius: 0.35rem;
    border: 1px solid var(--sl-color-gray-4);
    background: var(--sl-color-black);
    color: var(--sl-color-white);
  }
  .pst-setup .pst-problems {
    list-style: none;
    padding: 0.5rem 0.75rem;
    margin: 0;
    border-radius: var(--pst-radius);
    background: var(--sl-color-red-low);
    color: var(--sl-color-red-high);
    font-size: var(--sl-text-sm);
  }

  /* Wiring steps (chapter 0) */
  .pst-page-wiring {
    margin-top: var(--sl-content-gap-y);
  }
  .pst-setup .pst-wiring-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }
  .pst-setup .pst-wiring-count {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    font-variant-numeric: tabular-nums;
  }
  .pst-setup .pst-wiring-meter {
    flex: 1 1 8rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--sl-color-gray-5);
    overflow: hidden;
  }
  .pst-setup .pst-wiring-meter span {
    display: block;
    height: 100%;
    background: var(--sl-color-accent);
    transition: width 0.2s;
  }
  .pst-setup .pst-wiring-bar .pst-btn {
    margin: 0;
  }
  .pst-setup .pst-wsteps {
    margin-top: 1rem;
  }
  .pst-setup .pst-wstep {
    padding: 1rem 1.25rem 1.25rem;
    border: 2px solid var(--sl-color-gray-5);
    border-radius: var(--pst-radius);
